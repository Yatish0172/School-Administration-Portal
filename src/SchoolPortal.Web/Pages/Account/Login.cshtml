@page
@model SchoolPortal.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="auth-shell">
    <section class="auth-card">
        <p class="eyebrow">School Administration Portal</p>
        <h1>Welcome back</h1>
        @if (Model.PasswordRequired)
        {
            <p class="text-muted">Sign in with your staff account.</p>
        }
        else
        {
            <p class="text-muted">Choose your staff username. Passwords are temporarily disabled in this local desktop build.</p>
        }

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert alert-info">@Model.StatusMessage</div>
        }

        <form method="post">
            <input asp-for="Input.ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.Username" class="form-label"></label>
                <input asp-for="Input.Username" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Input.Username" class="text-danger"></span>
            </div>
            @if (Model.PasswordRequired)
            {
                <div class="mb-4">
                    <label asp-for="Input.Password" class="form-label"></label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
            }

            <button type="submit" class="btn btn-primary w-100">Sign in</button>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
