@page
@using SchoolPortal.Domain.Examinations
@model SchoolPortal.Web.Pages.Exams.ResultsModel
@{
    ViewData["Title"] = "Result review";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Examinations</p>
        <h1>Result review</h1>
        <p class="text-muted mb-0">Review completeness and performance before results are locked.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/Exams/Index" class="btn btn-outline-primary">Exam setup</a>
        <a asp-page="/Exams/Marks" asp-route-ExaminationId="@Model.ExaminationId" asp-route-SectionId="@Model.SectionId" class="btn btn-primary">Marks entry</a>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<section class="portal-panel mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-lg-6">
            <label asp-for="ExaminationId" class="form-label">Examination</label>
            <select asp-for="ExaminationId" class="form-select">
                @foreach (var exam in Model.Examinations)
                {
                    <option value="@exam.Id">@exam.Name · @exam.Status</option>
                }
            </select>
        </div>
        <div class="col-lg-4">
            <label asp-for="SectionId" class="form-label">Section</label>
            <select asp-for="SectionId" class="form-select">
                @foreach (var option in Model.Sections)
                {
                    <option value="@option.Id">@option.Name</option>
                }
            </select>
        </div>
        <div class="col-lg-2"><button type="submit" class="btn btn-primary w-100">Review</button></div>
    </form>
</section>

@if (Model.SelectedExamination is not null)
{
    <section class="portal-panel mb-4">
        <div class="d-flex flex-wrap justify-content-between gap-3">
            <div>
                <h2 class="h4 mb-1">@Model.SelectedExamination.Name</h2>
                <p class="text-muted mb-0">@Model.SelectedExamination.Class.Name · @Model.SelectedExamination.AcademicYear.Name</p>
            </div>
            <div class="d-flex flex-wrap gap-2 align-items-start">
                <span class="badge text-bg-@(Model.MissingMarks == 0 ? "success" : "warning")">@Model.MissingMarks missing</span>
                <span class="badge text-bg-secondary">@Model.SelectedExamination.Status</span>
            </div>
        </div>

        @if (Model.CanPublish && Model.SelectedExamination.Status == ExaminationStatus.MarksEntry)
        {
            <form method="post" asp-page-handler="Publish" class="mt-3">
                <input type="hidden" name="id" value="@Model.SelectedExamination.Id" />
                <input type="hidden" asp-for="SectionId" />
                <button type="submit" class="btn btn-success" disabled="@(Model.MissingMarks != 0)">Publish and lock results</button>
            </form>
        }
        else if (Model.CanPublish && Model.SelectedExamination.Status == ExaminationStatus.Published)
        {
            <form method="post" asp-page-handler="Reopen" class="row g-2 mt-3">
                <input type="hidden" name="id" value="@Model.SelectedExamination.Id" />
                <input type="hidden" asp-for="SectionId" />
                <div class="col-lg-8"><input asp-for="ReopenReason" class="form-control" required minlength="5" placeholder="Reason for reopening published results" /></div>
                <div class="col-lg-4"><button type="submit" class="btn btn-outline-danger w-100">Reopen for correction</button></div>
            </form>
        }
    </section>

    <section class="portal-panel mb-4">
        <h2 class="h4">Student performance</h2>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Roll</th><th>Student</th><th>Total</th><th>Percentage</th><th>Grade</th><th>Completeness</th></tr></thead>
                <tbody>
                    @foreach (var result in Model.Results)
                    {
                        <tr class="@(result.Missing > 0 ? "table-warning" : string.Empty)">
                            <td>@result.RollNumber</td>
                            <td>
                                <details>
                                    <summary><strong>@result.StudentName</strong><div class="text-muted small">@result.AdmissionNumber</div></summary>
                                    <table class="table table-sm mt-2">
                                        <thead><tr><th>Subject</th><th>Maximum</th><th>Pass</th><th>Obtained</th><th>Grade</th><th>Remarks</th></tr></thead>
                                        <tbody>
                                            @foreach (var line in result.Lines)
                                            {
                                                <tr><td>@line.SubjectName</td><td>@line.Maximum</td><td>@line.Pass</td><td>@(line.IsAbsent ? "AB" : line.Obtained?.ToString() ?? "—")</td><td>@(line.Grade ?? "—")</td><td>@(line.Remarks ?? "—")</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </details>
                            </td>
                            <td>@result.Obtained / @result.Maximum</td>
                            <td>@(result.Percentage?.ToString("0.00") ?? "—")%</td>
                            <td>@(result.Grade ?? "—")</td>
                            <td>@(result.Missing == 0 ? "Complete" : $"{result.Missing} missing")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @if (Model.StatusHistory.Count > 0)
    {
        <section class="portal-panel">
            <h2 class="h4">Publication history</h2>
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>Change</th><th>Reason</th><th>Time</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model.StatusHistory)
                        {
                            <tr><td>@item.OldStatus → @item.NewStatus</td><td>@(item.Reason ?? "—")</td><td>@item.ChangedAtUtc.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
