<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#13213c" />
    <title>@ViewData["Title"] - School Administration Portal</title>
    <script type="importmap"></script>
    <link rel="preload" href="~/fonts/NotoSans-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="~/fonts/NotoSans-Bold.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SchoolPortal.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/portal-theme.css" asp-append-version="true" />
</head>
<body class="portal-body">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header>
        <nav class="navbar navbar-expand-xl navbar-dark portal-navbar" aria-label="Primary navigation">
            <div class="container-fluid portal-nav-shell">
                <a class="navbar-brand" asp-page="/Index" aria-label="School Administration Portal dashboard">
                    <span class="brand-mark" aria-hidden="true">SP</span>
                    <span class="brand-copy">
                        <strong>School Administration Portal</strong>
                        <small>Operations workspace</small>
                    </span>
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#portalNavigation"
                            aria-controls="portalNavigation" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse justify-content-end" id="portalNavigation">
                        <ul class="navbar-nav align-items-xl-center">
                            <li class="nav-item"><a class="nav-link" asp-page="/Index">Dashboard</a></li>
                            @if (User.HasClaim(PermissionCatalog.ClaimType, PermissionCatalog.Students.View))
                            {
                                <li class="nav-item"><a class="nav-link" asp-page="/Students/Index">Students</a></li>
                            }
                            @if (User.HasClaim(PermissionCatalog.ClaimType, PermissionCatalog.Academics.Manage))
                            {
                                <li class="nav-item"><a class="nav-link" asp-page="/Academics/Index">Academics</a></li>
                            }
                            @if (User.HasClaim(PermissionCatalog.ClaimType, PermissionCatalog.Administration.ManageUsers))
                            {
                                <li class="nav-item"><a class="nav-link" asp-page="/Administration/Index">Administration</a></li>
                            }
                            @if (User.HasClaim(PermissionCatalog.ClaimType, PermissionCatalog.Attendance.View))
                            {
                                <li class="nav-item"><a class="nav-link" asp-page="/Attendance/Index">Attendance</a></li>
                            }
                            @if (User.HasClaim(PermissionCatalog.ClaimType, PermissionCatalog.Exams.View))
                            {
                                <li class="nav-item"><a class="nav-link" asp-page="/Exams/Index">Exams</a></li>
                            }
                            @if (User.HasClaim(PermissionCatalog.ClaimType, PermissionCatalog.Fees.View))
                            {
                                <li class="nav-item"><a class="nav-link" asp-page="/Fees/Overview">Fees</a></li>
                            }
                            @if (User.HasClaim(PermissionCatalog.ClaimType, PermissionCatalog.Library.View))
                            {
                                <li class="nav-item"><a class="nav-link" asp-page="/Library/Circulation">Library</a></li>
                            }
                            else if (User.HasClaim(PermissionCatalog.ClaimType, PermissionCatalog.Library.ViewFines))
                            {
                                <li class="nav-item"><a class="nav-link" asp-page="/Library/Fines">Library fines</a></li>
                            }
                            @if (User.HasClaim(PermissionCatalog.ClaimType, PermissionCatalog.Reports.View))
                            {
                                <li class="nav-item"><a class="nav-link" asp-page="/Reports/Index">Reports</a></li>
                            }
                            <li class="nav-item"><a class="nav-link" asp-page="/Account/ChangePassword">Security</a></li>
                            <li class="nav-item ms-xl-1">
                                <form method="post" asp-page="/Account/Logout">
                                    <button type="submit" class="btn btn-sm btn-outline-light">Sign out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </nav>
    </header>

    <div class="container-fluid portal-content">
        <main class="portal-main" role="main" id="main-content" tabindex="-1">
            @RenderBody()
        </main>
    </div>

    <footer class="portal-footer">
        <div class="container-fluid portal-nav-shell">
            <span>&copy; 2026 School Administration Portal</span>
            <span>Private · local · role-protected</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
