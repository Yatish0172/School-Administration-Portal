@page "{id:guid}"
@model SchoolPortal.Web.Pages.Students.EditModel
@{
    ViewData["Title"] = $"Edit {Model.StudentName}";
}

<div class="page-heading">
    <div>
        <p class="eyebrow">Student profile</p>
        <h1>Edit @Model.StudentName</h1>
        <p>Enrolment history is managed separately and is never overwritten.</p>
    </div>
    <a asp-page="/Students/Details" asp-route-id="@Model.StudentId" class="btn btn-outline-secondary">Cancel</a>
</div>

<form method="post" class="record-form">
    <input asp-for="Version" type="hidden" />
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <section class="data-panel">
        <div class="panel-heading"><div><h2>Student profile</h2></div></div>
        <div class="form-grid">
            <div><label asp-for="Input.AdmissionNumber" class="form-label"></label><input asp-for="Input.AdmissionNumber" class="form-control" /></div>
            <div><label asp-for="Input.AdmissionDate" class="form-label"></label><input asp-for="Input.AdmissionDate" class="form-control" /></div>
            <div><label asp-for="Input.FirstName" class="form-label"></label><input asp-for="Input.FirstName" class="form-control" /></div>
            <div><label asp-for="Input.MiddleName" class="form-label"></label><input asp-for="Input.MiddleName" class="form-control" /></div>
            <div><label asp-for="Input.LastName" class="form-label"></label><input asp-for="Input.LastName" class="form-control" /></div>
            <div><label asp-for="Input.DateOfBirth" class="form-label"></label><input asp-for="Input.DateOfBirth" class="form-control" /></div>
            <div><label asp-for="Input.Gender" class="form-label"></label><input asp-for="Input.Gender" class="form-control" /></div>
            <div><label asp-for="Input.BloodGroup" class="form-label"></label><input asp-for="Input.BloodGroup" class="form-control" /></div>
            <div><label asp-for="Input.Category" class="form-label"></label><input asp-for="Input.Category" class="form-control" /></div>
            <div><label asp-for="Input.Nationality" class="form-label"></label><input asp-for="Input.Nationality" class="form-control" /></div>
            <div><label asp-for="Input.AadhaarNumber" class="form-label"></label><input asp-for="Input.AadhaarNumber" class="form-control" maxlength="12" /></div>
            <div><label asp-for="Input.PreviousSchool" class="form-label"></label><input asp-for="Input.PreviousSchool" class="form-control" /></div>
            <div class="form-span-2"><label asp-for="Input.PermanentAddress" class="form-label"></label><textarea asp-for="Input.PermanentAddress" class="form-control" rows="2"></textarea></div>
            <div class="form-span-2"><label asp-for="Input.CorrespondenceAddress" class="form-label"></label><textarea asp-for="Input.CorrespondenceAddress" class="form-control" rows="2"></textarea></div>
            <div><label asp-for="Input.City" class="form-label"></label><input asp-for="Input.City" class="form-control" /></div>
            <div><label asp-for="Input.State" class="form-label"></label><input asp-for="Input.State" class="form-control" /></div>
            <div><label asp-for="Input.PinCode" class="form-label"></label><input asp-for="Input.PinCode" class="form-control" maxlength="6" /></div>
            <div class="form-span-2"><label asp-for="Input.Remarks" class="form-label"></label><textarea asp-for="Input.Remarks" class="form-control" rows="2"></textarea></div>
        </div>
    </section>

    <section class="data-panel">
        <div class="panel-heading"><div><h2>Guardians</h2></div></div>
        <div class="guardian-grid">
        @for (var index = 0; index < Model.Guardians.Count; index++)
        {
            <fieldset class="guardian-card">
                <legend>Guardian @(index + 1)</legend>
                <div class="form-grid">
                    <div><label asp-for="Guardians[index].Relation" class="form-label"></label><input asp-for="Guardians[index].Relation" class="form-control" /></div>
                    <div><label asp-for="Guardians[index].Name" class="form-label"></label><input asp-for="Guardians[index].Name" class="form-control" /></div>
                    <div><label asp-for="Guardians[index].Phone" class="form-label"></label><input asp-for="Guardians[index].Phone" class="form-control" /></div>
                    <div><label asp-for="Guardians[index].Email" class="form-label"></label><input asp-for="Guardians[index].Email" class="form-control" /></div>
                    <div><label asp-for="Guardians[index].Occupation" class="form-label"></label><input asp-for="Guardians[index].Occupation" class="form-control" /></div>
                    <div><label asp-for="Guardians[index].AnnualIncome" class="form-label"></label><input asp-for="Guardians[index].AnnualIncome" class="form-control" /></div>
                </div>
                <div class="form-check mt-3"><input asp-for="Guardians[index].IsPrimary" class="form-check-input" /><label asp-for="Guardians[index].IsPrimary" class="form-check-label"></label></div>
            </fieldset>
        }
        </div>
    </section>

    <div class="record-actions">
        <a asp-page="/Students/Details" asp-route-id="@Model.StudentId" class="btn btn-outline-secondary">Cancel</a>
        <button class="btn btn-primary" type="submit">Save changes</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
