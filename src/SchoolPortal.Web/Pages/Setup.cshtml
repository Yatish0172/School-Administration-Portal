@page
@model SchoolPortal.Web.Pages.SetupModel
@{
    ViewData["Title"] = "Create administrator";
}

<div class="auth-shell">
    <section class="auth-card">
        <div class="auth-brand" aria-hidden="true">
            <span class="brand-mark">SP</span>
            <span class="auth-brand-copy">
                <strong>School Administration Portal</strong>
                <small>Operations workspace</small>
            </span>
        </div>
        <p class="eyebrow">First-run setup</p>
        <h1>Create the super administrator</h1>
        <p class="text-muted">
            This one-time page is available only from this computer and closes
            permanently after the first account is created.
        </p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.DisplayName" class="form-label"></label>
                <input asp-for="Input.DisplayName" class="form-control" autocomplete="name" autofocus />
                <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Username" class="form-label"></label>
                <input asp-for="Input.Username" class="form-control" autocomplete="username" />
                <span asp-validation-for="Input.Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Create administrator</button>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
