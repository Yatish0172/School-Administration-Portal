@page
@model SchoolPortal.Web.Pages.Fees.IndexModel
@{
    ViewData["Title"] = "Fees";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Fees and collections</p>
        <h1>Fee structure</h1>
        <p>Set up fee categories, build a class fee structure, and assign it to students.</p>
    </div>
    <div class="record-actions">
        <a asp-page="/Fees/Ledger" class="btn btn-primary">Student ledger</a>
        @if (User.HasClaim(PermissionCatalog.ClaimType, PermissionCatalog.Fees.Reports))
        {
            <a asp-page="/Fees/Reports" class="btn btn-outline-primary">Reports</a>
        }
    </div>
</section>

<partial name="_FeesNav" />

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info">@Model.StatusMessage</div>
}
<div asp-validation-summary="All" class="text-danger mb-3"></div>

<div class="module-layout">
    <section class="data-panel">
        <div class="panel-heading">
            <div>
                <span class="setup-step">Step 1</span>
                <h2>Fee categories</h2>
                <p>Create reusable categories such as Tuition, Transport, or Annual Charges.</p>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Code</th><th>Name</th><th>Type</th><th>Status</th></tr></thead>
                <tbody>
                @if (Model.Heads.Count == 0)
                {
                    <tr><td colspan="4" class="empty-cell">No fee categories configured.</td></tr>
                }
                else
                {
                    @foreach (var head in Model.Heads)
                    {
                        <tr>
                            <td><strong>@head.Code</strong></td>
                            <td>@head.Name<div class="table-subtext">@head.Description</div></td>
                            <td>@(head.IsRefundable ? "Refundable" : "Non-refundable")</td>
                            <td><span class="status-pill @(head.IsActive ? "status-active" : "")">@(head.IsActive ? "Active" : "Inactive")</span></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        @if (Model.CanConfigure)
        {
            <details class="setup-action panel-heading-border">
                <summary>Add a fee category</summary>
            <form method="post" asp-page-handler="CreateHead" class="form-grid pt-3">
                <div><label asp-for="NewHead.Code" class="form-label"></label><input asp-for="NewHead.Code" class="form-control" /></div>
                <div><label asp-for="NewHead.Name" class="form-label"></label><input asp-for="NewHead.Name" class="form-control" /></div>
                <div class="form-span-2"><label asp-for="NewHead.Description" class="form-label"></label><input asp-for="NewHead.Description" class="form-control" /></div>
                <div><label asp-for="NewHead.SortOrder" class="form-label"></label><input asp-for="NewHead.SortOrder" class="form-control" /></div>
                <div class="d-flex align-items-end gap-3">
                    <label class="form-check"><input asp-for="NewHead.IsRefundable" class="form-check-input" /> Refundable</label>
                    <button type="submit" class="btn btn-primary ms-auto">Save category</button>
                </div>
            </form>
            </details>
        }
    </section>

    <section class="data-panel">
        <div class="panel-heading">
            <div><span class="setup-step">Step 2</span><h2>Class fee structures</h2><p>Choose an academic year and class, then create its fee schedule.</p></div>
        </div>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Academic year</th><th>Class</th><th>Plan</th><th>Scheduled total</th><th></th></tr></thead>
                <tbody>
                @if (Model.Plans.Count == 0)
                {
                    <tr><td colspan="5" class="empty-cell">No class fee structures configured.</td></tr>
                }
                else
                {
                    @foreach (var plan in Model.Plans)
                    {
                        <tr>
                            <td>@plan.AcademicYear.Name</td>
                            <td>@plan.Class.Name</td>
                            <td><strong>@plan.Name</strong></td>
                            <td>@plan.Items.Sum(x => x.Amount).ToString("N2")</td>
                            <td class="text-end"><a asp-page="/Fees/Index" asp-route-SelectedPlanId="@plan.Id" class="btn btn-sm btn-outline-primary">Open</a></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        @if (Model.CanConfigure)
        {
            <details class="setup-action panel-heading-border">
                <summary>Create a class fee structure</summary>
            <form method="post" asp-page-handler="CreatePlan" class="form-grid pt-3">
                <div>
                    <label asp-for="NewPlan.AcademicYearId" class="form-label">Academic year</label>
                    <select asp-for="NewPlan.AcademicYearId" class="form-select">
                        <option value="">Choose year</option>
                        @foreach (var year in Model.AcademicYears) { <option value="@year.Id">@year.Name</option> }
                    </select>
                </div>
                <div>
                    <label asp-for="NewPlan.ClassId" class="form-label">Class</label>
                    <select asp-for="NewPlan.ClassId" class="form-select">
                        <option value="">Choose class</option>
                        @foreach (var schoolClass in Model.Classes) { <option value="@schoolClass.Id">@schoolClass.Name</option> }
                    </select>
                </div>
                <div><label asp-for="NewPlan.Name" class="form-label"></label><input asp-for="NewPlan.Name" class="form-control" placeholder="Standard annual plan" /></div>
                <div class="d-flex align-items-end justify-content-end"><button type="submit" class="btn btn-primary">Create structure</button></div>
            </form>
            </details>
        }
    </section>

    @if (Model.SelectedPlan is not null)
    {
        <section class="data-panel">
            <div class="panel-heading">
                <div>
                    <span class="setup-step">Step 3</span>
                    <h2>Add installments and assign</h2>
                    <p><strong>@Model.SelectedPlan.Name</strong> · @Model.SelectedPlan.AcademicYear.Name · @Model.SelectedPlan.Class.Name</p>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Fee category</th><th>Installment / period</th><th>Due date</th><th>Amount</th></tr></thead>
                    <tbody>
                    @if (Model.SelectedPlan.Items.Count == 0)
                    {
                        <tr><td colspan="4" class="empty-cell">No installments added to this structure.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in Model.SelectedPlan.Items.OrderBy(x => x.DueDate))
                        {
                            <tr><td>@item.FeeHead.Name</td><td>@item.Period</td><td>@item.DueDate.ToString("dd MMM yyyy")</td><td>@item.Amount.ToString("N2")</td></tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
            @if (Model.CanConfigure)
            {
                <form method="post" asp-page-handler="AddItem" class="form-grid form-grid-4 panel-heading-border pt-3">
                    <input asp-for="NewItem.FeePlanId" type="hidden" value="@Model.SelectedPlan.Id" />
                    <div>
                        <label asp-for="NewItem.FeeHeadId" class="form-label">Fee category</label>
                        <select asp-for="NewItem.FeeHeadId" class="form-select">
                            <option value="">Choose category</option>
                            @foreach (var head in Model.Heads.Where(x => x.IsActive)) { <option value="@head.Id">@head.Name</option> }
                        </select>
                    </div>
                    <div><label asp-for="NewItem.Period" class="form-label"></label><input asp-for="NewItem.Period" class="form-control" placeholder="April 2026" /></div>
                    <div><label asp-for="NewItem.DueDate" class="form-label">Due date</label><input asp-for="NewItem.DueDate" class="form-control" type="date" /></div>
                    <div><label asp-for="NewItem.Amount" class="form-label"></label><input asp-for="NewItem.Amount" class="form-control" type="number" min="0.01" step="0.01" /></div>
                    <div class="form-span-2"><button type="submit" class="btn btn-primary">Add installment</button></div>
                </form>
                <form method="post" asp-page-handler="Assign" class="filter-bar">
                    <input type="hidden" name="planId" value="@Model.SelectedPlan.Id" />
                    <div class="filter-search">
                        <label for="sectionId" class="form-label">Assign this structure to active students in section</label>
                        <select id="sectionId" name="sectionId" class="form-select" required>
                            <option value="">Choose section</option>
                            @foreach (var sectionItem in Model.Sections) { <option value="@sectionItem.Id">@sectionItem.Name</option> }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-outline-primary">Create student charges</button>
                </form>
            }
        </section>
    }
</div>
